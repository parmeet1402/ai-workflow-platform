NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only: used to sign Storage URLs after verifying org access (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only: required on web (chat embed + completion) and on the document worker (ingest embeddings)
OPENAI_API_KEY=""
# Chat (web): model for completions; defaults to gpt-4o-mini if unset
CHAT_MODEL="gpt-4o-mini"
# Chat (web): must match worker embedding model/dims (text-embedding-3-small / 1536)
CHAT_EMBEDDING_MODEL="text-embedding-3-small"
# Chat (web): top-k chunks for RAG retrieval (default 6)
RAG_MATCH_COUNT="6"
# Server-only: Supabase Postgres URI (direct or pooler) for pgvector KNN in Next.js — never NEXT_PUBLIC_
DATABASE_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Worker only: Redis protocol URL from Upstash (rediss://), not the REST URL
UPSTASH_REDIS_URL=""
# Worker: same Supabase project URL as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=""
CRON_SECRET=""

